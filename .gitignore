# =====================================
# ESP-IDF generated files
# =====================================

# Generated build directories and local configuration
**/build/
**/sdkconfig
**/sdkconfig.old
**/managed_components/

# Python cache
__pycache__/
*.py[cod]

# Temporary files
*.tmp

# =====================================
# Visual Studio Code
# =====================================

# Ignore local editor state and machine-specific settings.
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/*.code-snippets
.history/
*.code-workspace

# =====================================
# KiCad generated / unnecessary files
# =====================================

# Local project settings
*.kicad_prl

# KiCad footprint cache
fp-info-cache

# Automatic backups
*-backups/
_autosave-*
*.bak

# Lock files
*.lck
~*.lck

# Temporary files
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_pcb~
*.kicad_sch~

# KiCad reports and logs
*-report.txt
drc.rpt
erc.rpt

# Optional generated manufacturing files
# Uncomment if Gerber files should not be tracked
# **/Gerber/
